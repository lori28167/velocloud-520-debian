#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""velocloud-status: live state of the router as JSON, for the web interface.

  velocloud-status            everything (ports, WAN, LAN, DHCP and Wi-Fi
                              clients, counters, system, pending change)
  velocloud-status --wifi-channels
"""

import json
import os
import re
import subprocess
import sys
import time

ETC = "/etc/velocloud"
JACKS = "/sys/devices/platform/velocloud-edge5x0/ports"
PORT_DEVS = ["lan14", "lan58", "ge1", "ge2", "sfp1", "sfp2"]


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def cmd(*args, timeout=5):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def iface(dev):
    base = f"/sys/class/net/{dev}"
    if not os.path.exists(base):
        return None
    carrier = read(f"{base}/carrier", "0") == "1"
    speed = int(read(f"{base}/speed", "-1") or -1) if carrier else 0
    return {
        "present": True,
        "up": read(f"{base}/operstate") == "up",
        "carrier": carrier,
        "speed": max(speed, 0),
        "duplex": read(f"{base}/duplex") if carrier else "",
        "mac": read(f"{base}/address"),
        "rx_bytes": int(read(f"{base}/statistics/rx_bytes", "0")),
        "tx_bytes": int(read(f"{base}/statistics/tx_bytes", "0")),
    }


def jacks():
    """Per-jack link of LAN1-8 from the switch port registers (igb module)."""
    out = {}
    for line in read(JACKS).splitlines():
        f = line.split()
        if len(f) >= 2:
            out[f[0]] = {"link": f[1] == "up",
                         "speed": int(f[2]) if len(f) > 2 and f[2].isdigit() and f[1] == "up" else 0,
                         "duplex": f[3] if len(f) > 3 and f[1] == "up" else ""}
    return out


def addresses():
    try:
        data = json.loads(cmd("ip", "-j", "addr") or "[]")
    except ValueError:
        data = []
    out = {}
    for i in data:
        out[i["ifname"]] = [f"{a['local']}/{a['prefixlen']}" for a in i.get("addr_info", [])
                            if a.get("scope") == "global"]
    return out


def default_route():
    try:
        for r in json.loads(cmd("ip", "-j", "route", "show", "default") or "[]"):
            return {"gateway": r.get("gateway", ""), "dev": r.get("dev", "")}
    except ValueError:
        pass
    return {"gateway": "", "dev": ""}


def wan_dns(dev):
    m = re.search(r"Current DNS Server: (\S+)|DNS Servers: (.+)", cmd("resolvectl", "status", dev))
    if not m:
        return []
    return (m.group(1) or m.group(2)).split()


def leases():
    out = []
    now = time.time()
    for line in read("/var/lib/misc/dnsmasq.leases").splitlines():
        f = line.split()
        if len(f) >= 4:
            exp = int(f[0])
            out.append({"mac": f[1], "ip": f[2], "name": "" if f[3] == "*" else f[3],
                        "expires_in": max(exp - int(now), 0) if exp else None})
    return out


def wifi(cfg):
    w = {"present": os.path.exists("/sys/class/net/wlan0"), "running": False, "clients": []}
    if not w["present"]:
        return w
    w["running"] = subprocess.run(["systemctl", "is-active", "--quiet", "hostapd"]).returncode == 0
    info = cmd("iw", "dev", "wlan0", "info")
    m = re.search(r"channel (\d+) \((\d+) MHz\), width: (\d+) MHz", info)
    if m:
        w.update(channel=int(m.group(1)), freq=int(m.group(2)), width=int(m.group(3)))
    m = re.search(r"txpower ([\d.]+) dBm", info)
    if m:
        w["txpower"] = float(m.group(1))
    users = {}
    for blk in cmd("hostapd_cli", "-p", "/run/hostapd", "all_sta").split("\n\n"):
        mac = re.match(r"([0-9a-f:]{17})", blk.strip())
        user = re.search(r"dot1xAuthSessionUserName=(.+)", blk)
        if mac and user:
            users[mac.group(1)] = user.group(1).strip()
    for blk in re.split(r"^Station ", cmd("iw", "dev", "wlan0", "station", "dump"), flags=re.M)[1:]:
        mac = blk.split()[0]
        def field(name):
            m = re.search(rf"{name}:\s*(.+)", blk)
            return m.group(1).strip() if m else ""
        sig = re.match(r"(-?\d+)", field("signal"))
        w["clients"].append({
            "mac": mac, "user": users.get(mac, ""),
            "signal": int(sig.group(1)) if sig else None,
            "rx_rate": field("rx bitrate").split(" MBit/s")[0],
            "tx_rate": field("tx bitrate").split(" MBit/s")[0],
            "connected": int(field("connected time").split()[0] or 0) if field("connected time") else 0,
        })
    return w


def wifi_channels():
    try:
        sys.path.insert(0, "/usr/local/sbin")
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader("vapply", "/usr/local/sbin/velocloud-apply")
        spec = importlib.util.spec_from_loader("vapply", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.wifi_channels()
    except Exception:
        return {}


def system():
    up = float(read("/proc/uptime", "0").split()[0])
    mem = {}
    for line in read("/proc/meminfo").splitlines():
        k, v = line.split(":", 1)
        mem[k] = int(v.split()[0])
    temps = []
    for t in sorted(os.listdir("/sys/class/hwmon")) if os.path.isdir("/sys/class/hwmon") else []:
        if read(f"/sys/class/hwmon/{t}/name") == "coretemp":
            for f in os.listdir(f"/sys/class/hwmon/{t}"):
                if re.fullmatch(r"temp\d+_input", f):
                    temps.append(int(read(f"/sys/class/hwmon/{t}/{f}", "0")) / 1000)
    return {
        "hostname": read("/etc/hostname"),
        "uptime": int(up),
        "load": [float(x) for x in read("/proc/loadavg", "0 0 0").split()[:3]],
        "mem_total": mem.get("MemTotal", 0) * 1024,
        "mem_available": mem.get("MemAvailable", 0) * 1024,
        "temp": max(temps) if temps else None,
        "kernel": os.uname().release,
    }


def radius():
    """RADIUS server certificate name, CA fingerprint and expiry (for the
    connection instructions), or {} before the Enterprise Wi-Fi is set up."""
    cd = "/etc/freeradius/3.0/certs/velocloud"
    if not os.path.exists(f"{cd}/server.pem"):
        return {}
    san = cmd("openssl", "x509", "-in", f"{cd}/server.pem", "-noout", "-ext", "subjectAltName", "-enddate")
    fp = cmd("openssl", "x509", "-in", f"{cd}/ca.pem", "-noout", "-fingerprint", "-sha256", "-subject")
    m = re.search(r"DNS:([^\s,]+)", san)
    e = re.search(r"notAfter=(.+)", san)
    f = re.search(r"Fingerprint=([0-9A-F:]+)", fp)
    s = re.search(r"CN\s*=\s*(.+)", fp)
    return {"server": m.group(1) if m else "", "server_expires": e.group(1).strip() if e else "",
            "ca_sha256": f.group(1) if f else "", "ca_name": s.group(1).strip() if s else ""}


def main():
    if sys.argv[1:] == ["--wifi-channels"]:
        print(json.dumps(wifi_channels()))
        return
    if sys.argv[1:] == ["--radius"]:
        print(json.dumps(radius()))
        return
    try:
        with open(f"{ETC}/router.json") as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    ports = cfg.get("ports", {})
    wan_port = next((p for p, r in ports.items() if r == "wan"), "ge1")
    wcfg = cfg.get("wan", {})
    wan_l3 = "ppp-wan" if wcfg.get("mode") == "pppoe" else (
        f"{wan_port}.{wcfg['vlan']}" if wcfg.get("vlan") else wan_port)
    addrs = addresses()
    route = default_route()
    pending = read(f"{ETC}/pending")
    status = {
        "time": time.time(),
        "system": system(),
        "ports": {p: iface(p) for p in PORT_DEVS},
        "jacks": jacks(),
        "wan": {"port": wan_port, "dev": wan_l3, "mode": wcfg.get("mode", "dhcp"),
                "addresses": addrs.get(wan_l3, []),
                "gateway": route["gateway"] if route["dev"] == wan_l3 else "",
                "online": route["dev"] == wan_l3, "dns": wan_dns(wan_l3),
                "counters": iface(wan_l3)},
        "lan": {"addresses": addrs.get("br-lan", []), "counters": iface("br-lan")},
        "leases": leases(),
        "wifi": wifi(cfg),
        "pending_until": int(pending) if pending.isdigit() else None,
    }
    print(json.dumps(status))


if __name__ == "__main__":
    main()
