#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# RADIUS side of the WPA2/WPA3-Enterprise Wi-Fi: FreeRADIUS on localhost (PEAP-MSCHAPv2,
# TTLS, EAP-TLS) with its own CA and the shared secret hostapd uses (hostapd.conf
# itself is generated by velocloud-apply).  Run by velocloud-apply when needed.
# Idempotent: keeps an existing CA, server certificate, secret and users.
#   wifi-setup [ORG]        e.g. wifi-setup "Example Org"
set -eu

ORG=${1:-VeloCloud}
CN=${SERVER_CN:-radius.$(echo "$ORG" | tr 'A-Z ' 'a-z-').lan}
FR=/etc/freeradius/3.0
CD=$FR/certs/velocloud
SECRET_FILE=$FR/velocloud-secret

# 1. CA (10 years) and RADIUS server certificate (825 days, serverAuth, SAN)
install -d -m 750 -o freerad -g freerad "$CD"
if [ ! -s "$CD/ca.pem" ]; then
	openssl req -x509 -newkey rsa:3072 -sha256 -days 3650 -nodes \
		-keyout "$CD/ca.key" -out "$CD/ca.pem" -subj "/O=$ORG/CN=$ORG Wi-Fi CA" \
		-addext "basicConstraints=critical,CA:TRUE" \
		-addext "keyUsage=critical,keyCertSign,cRLSign" 2>/dev/null
	echo "created CA: $ORG Wi-Fi CA"
fi
if [ ! -s "$CD/server.pem" ]; then
	ext=$(mktemp)
	printf 'basicConstraints=CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=DNS:%s\n' "$CN" > "$ext"
	openssl req -newkey rsa:3072 -sha256 -nodes -keyout "$CD/server.key" \
		-out "$CD/server.csr" -subj "/O=$ORG/CN=$CN" 2>/dev/null
	openssl x509 -req -in "$CD/server.csr" -CA "$CD/ca.pem" -CAkey "$CD/ca.key" \
		-CAcreateserial -days 825 -sha256 -extfile "$ext" -out "$CD/server.pem" 2>/dev/null
	rm -f "$ext" "$CD/server.csr"
	echo "created server certificate: $CN (expires $(openssl x509 -noout -enddate -in "$CD/server.pem" | cut -d= -f2))"
fi
chown -R freerad:freerad "$CD"; chmod 640 "$CD"/*.key; chmod 644 "$CD"/ca.pem

# 2. RADIUS shared secret (FreeRADIUS <-> hostapd, both on this box)
if [ ! -s "$SECRET_FILE" ]; then
	(umask 077; openssl rand -base64 33 | tr -d '/+=\n' > "$SECRET_FILE"; echo >> "$SECRET_FILE")
fi
chown root:freerad "$SECRET_FILE"; chmod 640 "$SECRET_FILE"
SECRET=$(cat "$SECRET_FILE")

# 3. FreeRADIUS: EAP with our certificates, PEAP by default, localhost only
E=$FR/mods-available/eap
sed -i -e "0,/^\(\s*\)default_eap_type = md5/s//\1default_eap_type = peap/" \
	-e "s/^\(\s*\)default_eap_type = md5/\1default_eap_type = mschapv2/" \
	-e "s|^\(\s*\)private_key_file = .*|\1private_key_file = \${certdir}/velocloud/server.key|" \
	-e "s|^\(\s*\)certificate_file = .*|\1certificate_file = \${certdir}/velocloud/server.pem|" \
	-e "s|^\(\s*\)ca_file = .*|\1ca_file = \${certdir}/velocloud/ca.pem|" "$E"
sed -i -e 's/^\(\s*\)ipaddr = \*/\1ipaddr = 127.0.0.1/' \
	-e 's/^\(\s*\)ipv6addr = ::\(\s\|$\)/\1ipv6addr = ::1\2/' $FR/sites-available/default
sed -i "s/^\(\s*secret\s*=\s*\)testing123\s*$/\1$SECRET/" $FR/clients.conf
grep -q '^# velocloud wifi-user' $FR/mods-config/files/authorize ||
	sed -i '1i # velocloud wifi-user: local Wi-Fi users (NT hash), managed by wifi-user\n# velocloud wifi-user end' $FR/mods-config/files/authorize
freeradius -XC >/dev/null 2>&1 || { echo "FreeRADIUS config check failed: run freeradius -XC"; exit 1; }
systemctl restart freeradius

echo "RADIUS ready: server name $CN, CA $CD/ca.pem"
