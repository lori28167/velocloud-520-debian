#!/bin/sh
# PPPoE WAN: hand the DNS servers (static ones from router.json, else the
# provider's) to systemd-resolved, which dnsmasq forwards to.
[ "$PPP_IFACE" = ppp-wan ] || exit 0
dns=$(cat /etc/velocloud/wan-dns 2>/dev/null)
[ -n "$dns" ] || dns="$DNS1 $DNS2"
resolvectl dns "$PPP_IFACE" $dns
resolvectl domain "$PPP_IFACE" "~."
resolvectl default-route "$PPP_IFACE" yes
